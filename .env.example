# Text-to-SQL Data Q&A Agent — Environment Variables
# Copy this file to .env.local and fill in your values.

# ─── Chat Provider (Required) ────────────────────────────────
# DeepSeek is the default. At least one chat provider key is required.
DEEPSEEK_API_KEY=sk-...

# ─── App Database (Required — Neon Serverless Postgres) ──────
# Stores auth + chat history. NOT the retail demo data.
# 1. Create a free account at https://console.neon.tech
# 2. Create a project and database
# 3. Copy the connection string (starts with postgresql://)
DATABASE_URL=postgresql://...

# ─── Retail Demo Database (Required — separate read-only DB) ──
# The retail_sales demo data the agent queries. MUST use a
# READ-ONLY role (retail_readonly) — see scripts/seed-retail-db.ts.
# The app runtime never has write access to this database.
RETAIL_DATABASE_URL=postgresql://retail_readonly:...

# Admin connection for seeding only (NOT used at runtime).
# Used by `npm run seed` to create tables + insert data + create
# the read-only role. Leave unset in production.
RETAIL_ADMIN_DATABASE_URL=postgresql://...
# Strong password set/reset by `npm run seed` for the retail_readonly role.
RETAIL_READONLY_PASSWORD=replace-with-a-strong-random-password

# ─── Authentication (Required) ───────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=your-secret-here
# Base URL of your app (used for redirects, cookies)
BETTER_AUTH_URL=http://localhost:3000

# ─── User Data Upload (optional — defaults below) ────────────
# Read-only connection used to query tables in the userdata schema.
# The username/password must match the deployment-provisioned userdata_readonly role.
USERDATA_DATABASE_URL=postgresql://userdata_readonly:...
# Deployment-only secret consumed by `npm run db:harden-userdata`; the running
# web app does not need it.
USERDATA_READONLY_PASSWORD=replace-with-a-strong-random-password

# Upload size / row limits. Tune these for your deployment.
# UPLOAD_MAX_FILE_MB=80          # Max file size in MB (default: 80)
# UPLOAD_MAX_ROWS=50000          # Max rows per file (default and hard cap: 50000)
# UPLOAD_BATCH_SIZE=2000         # Rows per INSERT batch (default: 2000)
# Upload, cleaning preview/apply, and export share the 50,000-row interactive limit.

# ─── Development ─────────────────────────────────────────────
# Set to "true" to skip authentication locally
DEV_MODE=true
# Set to "true" to allow isolated anonymous guest sessions in production
ALLOW_GUEST=true

# ─── Deployment / integration verification ──────────────────
# Dedicated disposable Neon database. Never point this at production.
# INTEGRATION_DATABASE_URL=postgresql://...
# Required acknowledgement before integration tests apply migrations/create data.
# ALLOW_DESTRUCTIVE_INTEGRATION=false
# Explicit database checked by `npm run db:check` after deployment migration.
# CHECK_DATABASE_URL=postgresql://...
# Explicit admin target used by `npm run db:harden-userdata`.
# HARDEN_DATABASE_URL=postgresql://...
# Set false only when user-upload functionality is intentionally disabled.
# CHECK_USERDATA_SECURITY=true
# Explicit target for the dry-run Guest cleanup command.
# CLEANUP_DATABASE_URL=postgresql://...
# GUEST_RETENTION_DAYS=30
# Required only together with `npm run guest:cleanup -- --execute`.
# CONFIRM_GUEST_CLEANUP=DELETE_EXPIRED_GUEST_DATA

# ─── Other Providers (optional) ──────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
