{
  "name": "text-to-sql-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:harden-userdata": "node --import tsx scripts/harden-userdata-role.ts",
    "db:check": "node --import tsx scripts/check-deployment-readiness.ts",
    "guest:cleanup": "node --import tsx scripts/cleanup-anonymous-users.ts",
    "seed": "npx tsx scripts/seed-retail-db.ts",
    "eval": "npx tsx eval/run-eval.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1",
    "@ai-sdk/google": "^1",
    "@ai-sdk/openai": "^1",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^4",
    "better-auth": "^1.6.22",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.21",
    "node-sql-parser": "^5.3.0",
    "papaparse": "^5.5.4",
    "react": "^19",
    "react-dom": "^19",
    "read-excel-file": "^9.3.5",
    "recharts": "^2.15.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.19",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "jsondiffpatch": "0.7.6",
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  }
}
